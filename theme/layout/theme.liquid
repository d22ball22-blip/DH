<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FAFAF8">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Font preconnects for zero-blocking {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}

  {{ content_for_header }}

  {%- comment -%} Inline critical CSS for above-the-fold perf {%- endcomment -%}
  <style>
    body { background: #FAFAF8; }
    .header { position: sticky; top: 0; z-index: 100; height: 80px; }
    .hero { height: 100svh; min-height: 600px; }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    window.AUVELLE = {
      routes: {
        cart_add:    '{{ routes.cart_add_url }}',
        cart_change: '{{ routes.cart_change_url }}',
        cart:        '{{ routes.cart_url }}'
      },
      freeShip:    {{ settings.free_shipping_threshold | default: 50 | times: 100 }},
      moneyFormat: {{ shop.money_format | json }}
    };
    document.documentElement.classList.remove('no-js');
  </script>
</head>

<body class="template-{{ request.page_type }}{% if request.page_type == 'index' %} is-home{% endif %}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {%- comment -%} Cart drawer {%- endcomment -%}
  {% render 'cart-drawer' %}

  {%- comment -%} Email popup — hide on checkout / cart / account pages {%- endcomment -%}
  {%- unless request.page_type == 'cart' or request.page_type == 'checkout' or request.page_type contains 'customer' -%}
    {% render 'popup' %}
  {%- endunless -%}

  {%- comment -%} Toast notification {%- endcomment -%}
  <div class="toast" id="toast" role="status" aria-live="polite">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m5 12 5 5L20 7"/>
    </svg>
    <span id="toastMsg"></span>
  </div>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
