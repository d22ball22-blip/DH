<article class="card">
  <a class="card__media" href="{{ card_product.url }}">
    {% if card_product.metafields.custom.badge %}<span class="card__tag">{{ card_product.metafields.custom.badge }}</span>{% endif %}
    {% if card_product.featured_image %}<img src="{{ card_product.featured_image | image_url: width: 800 }}" alt="{{ card_product.title | escape }}" loading="lazy" width="800" height="1000">{% else %}<div class="card__ph"></div>{% endif %}
  </a>
  <div class="card__body">
    <div class="card__rating"><span class="stars">★★★★★</span><small>({{ card_product.metafields.custom.review_count | default: '0' }})</small></div>
    <h3 class="card__name"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
    <p class="card__desc">{{ card_product.metafields.custom.subtitle | default: card_product.type }}</p>
    <div class="card__foot"><span class="card__price">{{ card_product.price | money }}</span>
      <product-form>
        {% form 'product', card_product, class: 'card__add' %}
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="submit" class="link-underline" {% unless card_product.available %}disabled{% endunless %}>{% if card_product.available %}Add{% else %}Sold out{% endif %}</button>
        {% endform %}
      </product-form>
    </div>
  </div>
</article>