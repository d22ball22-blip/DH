<div class="announce" role="region" aria-label="Store announcements">
  <div class="announce__track" id="announceTrack">
    {% for block in section.blocks %}
      {% if block.type == 'message' %}
        <span class="announce__item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </span>
        <span class="announce__sep" aria-hidden="true">✦</span>
      {% endif %}
    {% endfor %}
    {%- comment -%} Duplicate for seamless loop — JS also handles this for dynamic content {%- endcomment -%}
    {% for block in section.blocks %}
      {% if block.type == 'message' %}
        <span class="announce__item" aria-hidden="true">
          {{ block.settings.text }}
        </span>
        <span class="announce__sep" aria-hidden="true">✦</span>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Message",
          "default": "<p>Complimentary shipping over <b>$50</b></p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "<p>Complimentary shipping over <b>$50</b></p>"
