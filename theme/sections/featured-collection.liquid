<section class="section" id="collection"><div class="wrap">
  <div class="sec-head center reveal"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="display-md">{{ section.settings.heading }}</h2></div>
  <div class="prod-grid">
    {% assign coll = collections[section.settings.collection] %}
    {% for product in coll.products limit: section.settings.count %}{% render 'product-card', card_product: product %}{% else %}
      {% for i in (1..4) %}<article class="card"><a class="card__media"><div class="card__ph"></div></a><div class="card__body"><h3 class="card__name">Product title</h3><p class="card__desc">Select a collection in the editor</p></div></article>{% endfor %}
    {% endfor %}
  </div>
</div></section>
{% schema %}
{ "name": "Featured products", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
  { "type": "html", "id": "heading", "label": "Heading", "default": "Four essentials for an effortless, <em class='serif-it'>year-round</em> glow." },
  { "type": "collection", "id": "collection", "label": "Collection" },
  { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
], "presets": [ { "name": "Featured products" } ] }
{% endschema %}