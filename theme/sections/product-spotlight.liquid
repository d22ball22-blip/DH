<section class="section {{ section.settings.bg }}" id="{{ section.settings.anchor }}">
  <div class="wrap">
    <div class="spot {% if section.settings.reverse %}spot--rev{% endif %} reveal">

      {%- comment -%} Media column {%- endcomment -%}
      <div class="spot__media {% if section.settings.tall %}spot__media--tall{% endif %}">
        {% if section.settings.product_url != blank %}
          <a class="spot__imglink" href="{{ section.settings.product_url }}" aria-label="{{ section.settings.heading | escape }}">
        {% endif %}
          <img
            src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1100 }}{% else %}{{ 'glow-product.jpg' | asset_url }}{% endif %}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy">
        {% if section.settings.product_url != blank %}
          </a>
        {% endif %}

        {%- comment -%} Floating info badge {%- endcomment -%}
        {% if section.settings.badge_title != blank %}
          <div class="spot__float">
            <span class="ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2C8 2 5 6 5 10c0 5 7 12 7 12s7-7 7-12c0-4-3-8-7-8z"/>
                <circle cx="12" cy="10" r="2.5"/>
              </svg>
            </span>
            <p><b>{{ section.settings.badge_title }}</b>{{ section.settings.badge_sub }}</p>
          </div>
        {% endif %}
      </div>

      {%- comment -%} Copy column {%- endcomment -%}
      <div class="spot__copy">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="display-md">{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.text }}</p>

        {%- assign linked = all_products[section.settings.product] -%}
        {% if linked.id %}
          <div class="spot__price">
            <span class="now">{{ linked.price | money }}</span>
            <span class="stars">★★★★★</span>
          </div>
        {% endif %}

        <ul class="benefit-list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m5 12 5 5L20 7"/>
              </svg>
              {{ block.settings.text }}
            </li>
          {% endfor %}
        </ul>

        <div class="spot__cta">
          {% if linked.id %}
            {% form 'product', linked %}
              <input type="hidden" name="id" value="{{ linked.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn--primary">
                Add to Bag — {{ linked.price | money }}
              </button>
            {% endform %}
            <a href="{{ linked.url }}" class="link-arrow">
              Learn more
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
                <line x1="3" y1="8" x2="13" y2="8"/>
                <polyline points="8,3 13,8 8,13"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "text",         "id": "anchor",       "label": "Section ID",          "default": "glow" },
    { "type": "select",       "id": "bg",            "label": "Background",
      "options": [
        { "value": "",                "label": "Parchment (default)" },
        { "value": "section--tint",   "label": "Warm tint" },
        { "value": "section--blush",  "label": "Blush" },
        { "value": "section--sand",   "label": "Sand" },
        { "value": "section--white",  "label": "White" }
      ],
      "default": "" },
    { "type": "checkbox",     "id": "reverse",      "label": "Image on right",      "default": false },
    { "type": "checkbox",     "id": "tall",          "label": "Use tall image ratio", "default": false },
    { "type": "image_picker", "id": "image",         "label": "Product image" },
    { "type": "url",          "id": "product_url",   "label": "Product URL (image link)" },
    { "type": "text",         "id": "eyebrow",       "label": "Eyebrow",            "default": "Best Seller · The Icon" },
    { "type": "text",         "id": "heading",       "label": "Product name",       "default": "Radiance Glow Drops" },
    { "type": "textarea",     "id": "text",          "label": "Description",        "default": "A customisable tanning serum you blend into your daily moisturiser." },
    { "type": "product",      "id": "product",       "label": "Linked product (for price & add to cart)" },
    {
      "type": "header",
      "content": "Floating badge"
    },
    { "type": "text",         "id": "badge_title",   "label": "Badge headline",     "default": "Clinically Tested" },
    { "type": "text",         "id": "badge_sub",     "label": "Badge supporting text", "default": " · Dermatologist approved" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Benefit text", "default": "Fully buildable, never streaky" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product spotlight",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
