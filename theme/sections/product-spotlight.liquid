<section class="section {{ section.settings.bg }}" id="{{ section.settings.anchor }}"><div class="wrap">
  <div class="spot {% if section.settings.reverse %}spot--rev{% endif %} reveal">
    <div class="spot__media {% if section.settings.tall %}spot__media--tall{% endif %}">
      <img src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1100 }}{% else %}{{ 'glow-product.jpg' | asset_url }}{% endif %}" alt="{{ section.settings.heading | escape }}">
    </div>
    <div class="spot__copy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="display-md">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.text }}</p>
      {% if section.settings.product != blank %}{% assign p = all_products[section.settings.product] %}
      <div class="spot__price"><span class="now">{{ p.price | money }}</span><span class="stars">★★★★★</span></div>{% endif %}
      <ul class="benefit-list">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{% render 'icon', icon: 'check' %}{{ block.settings.text }}</li>{% endfor %}</ul>
      <div class="spot__cta">
        {% if section.settings.product != blank %}{% assign p = all_products[section.settings.product] %}
        {% form 'product', p %}<input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><button type="submit" class="btn btn--primary">Add to Bag — {{ p.price | money }}</button>{% endform %}
        {% endif %}
      </div>
    </div>
  </div>
</div></section>
{% schema %}
{ "name": "Product spotlight", "settings": [
  { "type": "text", "id": "anchor", "label": "Anchor id", "default": "glow" },
  { "type": "select", "id": "bg", "label": "Background", "options": [ {"value":"","label":"Ivory"},{"value":"section--tint","label":"Tint"},{"value":"section--sand","label":"Sand"} ], "default": "" },
  { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
  { "type": "checkbox", "id": "tall", "label": "Tall image", "default": false },
  { "type": "image_picker", "id": "image", "label": "Image" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best Seller · The Icon" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Radiance Glow Drops" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "A customisable tanning serum you blend into your daily moisturiser." },
  { "type": "product", "id": "product", "label": "Linked product" }
], "blocks": [ { "type": "benefit", "name": "Benefit", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Fully buildable, never streaky" } ] } ],
  "presets": [ { "name": "Product spotlight", "blocks": [ {"type":"benefit"},{"type":"benefit"},{"type":"benefit"} ] } ] }
{% endschema %}