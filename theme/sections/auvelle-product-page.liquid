              <span class="au-ba-panel__label">After</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment %} ══ 10. UGC VIDEOS ══════════════════════════════ {% endcomment %}
  {%- assign ugc_blocks = section.blocks | where: 'type', 'ugc_video' -%}
  {%- if ugc_blocks.size > 0 -%}
    <div class="au-section">
      <div class="au-container">
        <div class="au-section-head">
