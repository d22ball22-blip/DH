<script>
(function () {
  'use strict';

  var sectionId = {{ section.id | json }};
  var root = document.getElementById('auvelle-' + sectionId);
  if (!root) return;

  /* ── Gallery ─────────────────────────────────── */
  var mainImg  = document.getElementById('au-gallery-main-' + sectionId);
  var thumbBtns = root.querySelectorAll('[data-au-thumb]');

  thumbBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (mainImg) {
        mainImg.src = btn.dataset.src;
        mainImg.alt = btn.dataset.alt || '';
      }
      thumbBtns.forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });

  /* ── Quantity stepper ────────────────────────── */
  var qtyInput = root.querySelector('#au-qty-' + sectionId);
  root.querySelector('[data-au-qty-minus]') && root.querySelector('[data-au-qty-minus]').addEventListener('click', function () {
    if (!qtyInput) return;
    var v = parseInt(qtyInput.value, 10);
    if (v > 1) qtyInput.value = v - 1;
  });
  root.querySelector('[data-au-qty-plus]') && root.querySelector('[data-au-qty-plus]').addEventListener('click', function () {
    if (!qtyInput) return;
    qtyInput.value = parseInt(qtyInput.value, 10) + 1;
  });

  /* ── Variant option highlighting ─────────────── */
  root.querySelectorAll('[data-au-option]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      var group = radio.closest('[role="radiogroup"]');
      if (!group) return;
      group.querySelectorAll('.au-variants__option').forEach(function (span) {
        span.classList.remove('is-active');
      });
      radio.nextElementSibling && radio.nextElementSibling.classList.add('is-active');
    });
  });

  /* ── Bundle card selection ───────────────────── */
  root.querySelectorAll('[data-au-bundle]').forEach(function (card) {
    card.addEventListener('click', function () {
      root.querySelectorAll('[data-au-bundle]').forEach(function (c) { c.classList.remove('is-selected'); });
      card.classList.add('is-selected');
    });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
    });
  });

  /* ── FAQ accordion ───────────────────────────── */
  root.querySelectorAll('[data-au-faq-trigger]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var faq = btn.closest('.au-faq');
      var isOpen = faq.classList.contains('is-open');
      root.querySelectorAll('.au-faq.is-open').forEach(function (f) {
        f.classList.remove('is-open');
        f.querySelector('[data-au-faq-trigger]').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        faq.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ── UGC modal ───────────────────────────────── */
  var ugcModal   = document.getElementById('au-ugc-modal-' + sectionId);
  var ugcContent = document.getElementById('au-modal-content-' + sectionId);

  root.querySelectorAll('[data-au-ugc-trigger]').forEach(function (card) {
    card.addEventListener('click', function () {
      var videoUrl = card.dataset.videoUrl;
      if (!ugcModal || !ugcContent || !videoUrl) return;
      ugcContent.innerHTML = '';
      /* Supports mp4 files or embed URLs */
      if (videoUrl.match(/\.(mp4|webm|ogg)(\?|$)/i)) {
        var vid = document.createElement('video');
        vid.src = videoUrl;
        vid.controls = true;
        vid.autoplay = true;
        vid.playsInline = true;
        ugcContent.appendChild(vid);
      } else {
        var iframe = document.createElement('iframe');
        iframe.src = videoUrl;
        iframe.allowFullscreen = true;
        iframe.allow = 'autoplay; fullscreen';
        ugcContent.appendChild(iframe);
      }
      ugcModal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeUgcModal() {
    if (!ugcModal) return;
    ugcModal.classList.remove('is-open');
    document.body.style.overflow = '';
    if (ugcContent) ugcContent.innerHTML = '';
  }

  ugcModal && ugcModal.querySelector('[data-au-modal-close]') && ugcModal.querySelector('[data-au-modal-close]').addEventListener('click', closeUgcModal);
  ugcModal && ugcModal.addEventListener('click', function (e) { if (e.target === ugcModal) closeUgcModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeUgcModal(); });

  /* ── Sticky ATC ──────────────────────────────── */
  var stickyBar = document.getElementById('au-sticky-' + sectionId);
  var heroAtc   = root.querySelector('#au-atc-' + sectionId);

  if (stickyBar && heroAtc) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      });
    }, { threshold: 0.1 });
    observer.observe(heroAtc);
  }

  /* Sticky ATC click — scroll to / submit main form */
  var stickyBtn = root.querySelector('[data-au-sticky-btn]');
  if (stickyBtn) {
    stickyBtn.addEventListener('click', function () {
      if (heroAtc) {
        heroAtc.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function () { heroAtc.click(); }, 600);
      }
    });
  }

})();
</script>

