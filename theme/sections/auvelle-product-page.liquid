</div>{%- comment %} /au-{{ section.id }} {% endcomment %}

<script>
(function() {
  'use strict';
  var sid = {{ section.id | json }};
  var root = document.getElementById('au-' + sid);
  if (!root) return;

  /* ── Gallery ──────────────────────────────────── */
  var mainImg = document.getElementById('au-main-img-' + sid);
  root.querySelectorAll('[data-au-thumb]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (mainImg) { mainImg.src = btn.dataset.src; }
      root.querySelectorAll('[data-au-thumb]').forEach(function(b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });

  /* ── Quantity stepper ─────────────────────────── */
  var qtyEl = root.querySelector('#au-qty-' + sid);
  root.querySelector('[data-au-minus]') && root.querySelector('[data-au-minus]').addEventListener('click', function() {
    if (!qtyEl) return;
    var v = parseInt(qtyEl.value, 10);
    if (v > 1) qtyEl.value = v - 1;
  });
  root.querySelector('[data-au-plus]') && root.querySelector('[data-au-plus]').addEventListener('click', function() {
    if (!qtyEl) return;
    qtyEl.value = parseInt(qtyEl.value, 10) + 1;
  });

  /* ── Variant radio highlight ──────────────────── */
  root.querySelectorAll('[data-au-option]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var group = radio.closest('[role="radiogroup"]');
      if (!group) return;
      group.querySelectorAll('.au-variants__btn').forEach(function(s) {
        s.classList.remove('is-active');
        s.setAttribute('aria-checked', 'false');
      });
      if (radio.nextElementSibling) {
        radio.nextElementSibling.classList.add('is-active');
        radio.nextElementSibling.setAttribute('aria-checked', 'true');
      }
    });
  });

  /* ── Bundle card selection ────────────────────── */
  root.querySelectorAll('[data-au-bundle]').forEach(function(card) {
    card.addEventListener('click', function() {
      root.querySelectorAll('[data-au-bundle]').forEach(function(c) { c.classList.remove('is-selected'); });
      card.classList.add('is-selected');
    });
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
    });
  });

  /* ── FAQ accordion ────────────────────────────── */
  root.querySelectorAll('[data-au-faq]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var faq = btn.closest('.au-faq');
      var open = faq.classList.contains('is-open');
      root.querySelectorAll('.au-faq.is-open').forEach(function(f) {
        f.classList.remove('is-open');
        f.querySelector('[data-au-faq]').setAttribute('aria-expanded', 'false');
      });
      if (!open) {
        faq.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ── UGC modal ────────────────────────────────── */
  var modal = document.getElementById('au-modal-' + sid);
  var modalContent = document.getElementById('au-modal-content-' + sid);

  function openModal(url) {
    if (!modal || !modalContent || !url) return;
    modalContent.innerHTML = '';
    if (/\.(mp4|webm|ogg)(\?|$)/i.test(url)) {
      var v = document.createElement('video');
      v.src = url; v.controls = true; v.autoplay = true; v.playsInline = true;
      modalContent.appendChild(v);
    } else {
      var f = document.createElement('iframe');
      f.src = url; f.allowFullscreen = true; f.allow = 'autoplay; fullscreen';
      modalContent.appendChild(f);
    }
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    if (modalContent) modalContent.innerHTML = '';
  }
  root.querySelectorAll('[data-au-ugc]').forEach(function(card) {
    card.addEventListener('click', function() { openModal(card.dataset.video); });
    card.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card.dataset.video); } });
  });
  modal && modal.querySelector('[data-au-modal-close]') && modal.querySelector('[data-au-modal-close]').addEventListener('click', closeModal);
  modal && modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

  /* ── Sticky ATC ───────────────────────────────── */
  var stickyBar = document.getElementById('au-sticky-' + sid);
  var heroAtc   = document.getElementById('au-atc-' + sid);
  var stickyBtn = root.querySelector('[data-au-sticky-btn]');

  if (stickyBar && heroAtc && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      stickyBar.classList.toggle('is-visible', !entries[0].isIntersecting);
    }, { threshold: 0.1 });
    obs.observe(heroAtc);
  }
  if (stickyBtn) {
    stickyBtn.addEventListener('click', function() {
      if (heroAtc) {
        heroAtc.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function() { heroAtc.click(); }, 550);
      }
    });
  }
})();
</script>

