                <img src="{{ block.settings.before_image | img_url: '700x875', crop: 'center' }}" alt="Before" loading="lazy" width="700" height="875">
              {%- else -%}
                <div style="background:var(--au-beige-dk);width:100%;height:100%;"></div>
              {%- endif -%}
