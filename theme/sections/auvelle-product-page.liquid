{% comment %}
  ============================================================
  Auvelle Beauty — Product Page Section
  File: sections/auvelle-product-page.liquid
  Design: Cormorant Garamond + Jost · Cream #faf5ee · Gold #b89a5e
  Shopify Online Store 2.0 compatible
  ============================================================
{% endcomment %}

{%- liquid
  assign product        = product
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'auvelle-pf-' | append: section.id
  assign sec_bg         = section.settings.section_bg_color   | default: '#faf5ee'
  assign text_col       = section.settings.text_color         | default: '#1a1a1a'
  assign accent_col     = section.settings.accent_color       | default: '#b89a5e'
  assign btn_bg         = section.settings.button_color       | default: '#1a1a1a'
  assign btn_txt        = section.settings.button_text_color  | default: '#ffffff'
-%}

{%- comment %} ── Google Fonts (Cormorant Garamond + Jost) ── {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
/* ── Reset ──────────────────────────────────────────── */
#au-{{ section.id }} *, #au-{{ section.id }} *::before, #au-{{ section.id }} *::after {
  box-sizing: border-box; margin: 0; padding: 0;
}

/* ── Design tokens (from Auvelle design file) ───────── */
#au-{{ section.id }} {
  --au-cream:      {{ sec_bg }};
  --au-text:       {{ text_col }};
  --au-gold:       {{ accent_col }};
  --au-gold-lt:    #cbb274;
  --au-gold-dk:    #9a8358;
  --au-beige:      #ece2d3;
  --au-beige-lt:   #f3ecdf;
  --au-beige-dk:   #e7d8c1;
  --au-muted:      #7a7268;
  --au-muted-dk:   #5a544c;
  --au-warm-dk:    #3a352f;
  --au-btn:        {{ btn_bg }};
  --au-btn-text:   {{ btn_txt }};
  --au-border:     #efe7da;
  --au-radius-sm:  4px;
  --au-radius:     8px;
  --au-radius-lg:  12px;
  --au-pill:       999px;
  --au-gap:        {{ section.settings.section_padding | default: 80 }}px;
  --au-serif:      'Cormorant Garamond', Georgia, serif;
  --au-sans:       'Jost', -apple-system, BlinkMacSystemFont, sans-serif;

  background: var(--au-cream);
  color: var(--au-text);
  font-family: var(--au-sans);
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* ── Typography ─────────────────────────────────────── */
#au-{{ section.id }} .au-eyebrow {
  font-family: var(--au-sans);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .26em;
  text-transform: uppercase;
  color: var(--au-gold);
}
#au-{{ section.id }} .au-serif-eyebrow {
  font-family: var(--au-serif);
  font-size: 14px;
  font-style: italic;
  font-weight: 300;
  color: var(--au-muted);
  letter-spacing: .06em;
}
#au-{{ section.id }} h1, #au-{{ section.id }} .au-h1 {
  font-family: var(--au-serif);
  font-size: clamp(32px, 5vw, 56px);
  font-weight: 300;
  line-height: 1.08;
  letter-spacing: -.01em;
}
#au-{{ section.id }} h2, #au-{{ section.id }} .au-h2 {
  font-family: var(--au-serif);
  font-size: clamp(26px, 4vw, 44px);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -.01em;
}
#au-{{ section.id }} h3, #au-{{ section.id }} .au-h3 {
  font-family: var(--au-serif);
  font-size: clamp(18px, 2.5vw, 26px);
  font-weight: 400;
  line-height: 1.25;
}
#au-{{ section.id }} p {
  font-family: var(--au-sans);
  font-size: 15px;
  font-weight: 300;
  line-height: 1.7;
  color: var(--au-muted-dk);
}

/* ── Layout ─────────────────────────────────────────── */
#au-{{ section.id }} .au-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}
#au-{{ section.id }} .au-section {
  padding-top: var(--au-gap);
  padding-bottom: var(--au-gap);
}
#au-{{ section.id }} .au-section--beige { background: var(--au-beige-lt); }
#au-{{ section.id }} .au-section--dark {
  background: var(--au-warm-dk);
  color: var(--au-cream);
}
#au-{{ section.id }} .au-section--dark p { color: rgba(250,245,238,.65); }
#au-{{ section.id }} .au-section-head {
  text-align: center;
  margin-bottom: 56px;
}
#au-{{ section.id }} .au-section-head p {
  max-width: 520px;
  margin: 14px auto 0;
}
#au-{{ section.id }} .au-divider {
  width: 40px;
  height: 1px;
  background: var(--au-gold);
  margin: 14px auto;
}

/* ── Buttons ─────────────────────────────────────────── */
#au-{{ section.id }} .au-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: var(--au-sans);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
  padding: 16px 36px;
  border-radius: var(--au-pill);
  border: 1.5px solid var(--au-btn);
  background: var(--au-btn);
  color: var(--au-btn-text);
  cursor: pointer;
  transition: all .22s ease;
  text-decoration: none;
  white-space: nowrap;
  width: 100%;
}
#au-{{ section.id }} .au-btn:hover { opacity: .82; transform: translateY(-1px); }
#au-{{ section.id }} .au-btn:active { transform: translateY(0); }
#au-{{ section.id }} .au-btn[disabled], #au-{{ section.id }} .au-btn[aria-disabled='true'] {
  opacity: .38; pointer-events: none;
}
#au-{{ section.id }} .au-btn--outline {
  background: transparent;
  color: var(--au-btn);
}
#au-{{ section.id }} .au-btn--gold {
  background: var(--au-gold);
  border-color: var(--au-gold);
  color: #fff;
}
#au-{{ section.id }} .au-btn--gold-outline {
  background: transparent;
  border-color: var(--au-gold);
  color: var(--au-gold);
}

/* ── Stars ───────────────────────────────────────────── */
#au-{{ section.id }} .au-stars { color: var(--au-gold); font-size: 13px; letter-spacing: 1px; }
#au-{{ section.id }} .au-stars--lg { font-size: 18px; }

/* ── Badges ──────────────────────────────────────────── */
#au-{{ section.id }} .au-badge {
  font-family: var(--au-sans);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .2em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: var(--au-pill);
  display: inline-block;
}
#au-{{ section.id }} .au-badge--gold { background: var(--au-gold); color: #fff; }
#au-{{ section.id }} .au-badge--dark { background: var(--au-warm-dk); color: var(--au-cream); }
#au-{{ section.id }} .au-badge--green { background: #3a5a40; color: #fff; }
#au-{{ section.id }} .au-badge--outline {
  background: transparent;
  border: 1px solid var(--au-gold);
  color: var(--au-gold);
}

/* ════════════════════════════════════════════════════
   SECTION 1+2 — HERO + GALLERY
════════════════════════════════════════════════════ */
.au-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  padding-top: 48px;
  padding-bottom: 80px;
  align-items: start;
}
/* Gallery */
.au-gallery { display: grid; grid-template-columns: 72px 1fr; gap: 14px; position: sticky; top: 100px; align-self: start; }
.au-gallery__thumbs { display: flex; flex-direction: column; gap: 10px; }
.au-gallery__thumb {
  width: 72px; height: 72px; border-radius: var(--au-radius-sm);
  overflow: hidden; cursor: pointer;
  border: 1.5px solid transparent; transition: border-color .2s;
  background: var(--au-beige);
}
.au-gallery__thumb.is-active { border-color: var(--au-gold); }
.au-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.au-gallery__main-wrap { position: relative; border-radius: var(--au-radius); overflow: hidden; background: var(--au-beige-lt); }
.au-gallery__main { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
.au-gallery__badge-wrap { position: absolute; top: 16px; left: 16px; z-index: 2; }

/* Hero info */
.au-hero__info { display: flex; flex-direction: column; gap: 24px; }
.au-hero__meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.au-hero__rating-label { font-size: 12px; color: var(--au-muted); letter-spacing: .06em; }
.au-hero__price-row { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.au-hero__price {
  font-family: var(--au-serif);
  font-size: 36px;
  font-weight: 300;
  letter-spacing: -.01em;
  color: var(--au-text);
}
.au-hero__compare {
  font-size: 20px;
  color: var(--au-muted);
  text-decoration: line-through;
  font-weight: 300;
}
.au-hero__save {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #3a5a40;
  background: #d8eedc;
  padding: 4px 12px;
  border-radius: var(--au-pill);
}

/* Variants */
.au-variants { display: flex; flex-direction: column; gap: 14px; }
.au-variants__label {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--au-muted);
}
.au-variants__options { display: flex; gap: 8px; flex-wrap: wrap; }
.au-variants__btn {
  padding: 10px 22px;
  border-radius: var(--au-pill);
  border: 1px solid var(--au-border);
  background: transparent;
  font-family: var(--au-sans);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: .06em;
  cursor: pointer;
  color: var(--au-text);
  transition: all .18s;
}
.au-variants__btn.is-active {
  border-color: var(--au-text);
  background: var(--au-text);
  color: var(--au-cream);
}

/* Quantity */
.au-qty { display: flex; flex-direction: column; gap: 10px; }
.au-qty__label { font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--au-muted); }
.au-qty__row { display: flex; align-items: center; gap: 16px; }
.au-qty__stepper {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--au-border);
  border-radius: var(--au-pill);
  overflow: hidden;
}
.au-qty__btn {
  width: 44px; height: 44px;
  background: none; border: none;
  font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--au-text);
  transition: background .15s;
}
.au-qty__btn:hover { background: var(--au-beige); }
.au-qty__input {
  width: 44px; text-align: center;
  border: none; background: none;
  font-family: var(--au-sans);
  font-size: 14px; font-weight: 400;
  color: var(--au-text);
  -moz-appearance: textfield;
}
.au-qty__input::-webkit-outer-spin-button,
.au-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; }

/* ATC */
.au-hero__cta { display: flex; flex-direction: column; gap: 12px; }
.au-hero__atc { font-size: 13px; padding: 18px 40px; }
.au-hero__dynamic { text-align: center; }

/* Trust strip */
.au-trust-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border: 1px solid var(--au-border);
  border-radius: var(--au-radius);
  overflow: hidden;
}
.au-trust-strip__item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-right: 1px solid var(--au-border);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: .04em;
  color: var(--au-muted-dk);
}
.au-trust-strip__item:last-child { border-right: none; }
.au-trust-strip__icon { font-size: 18px; flex-shrink: 0; }

/* Shipping progress */
.au-ship-bar { display: flex; flex-direction: column; gap: 8px; }
.au-ship-bar__label {
  font-size: 12px;
  font-weight: 300;
  letter-spacing: .06em;
  text-align: center;
  color: var(--au-muted-dk);
}
.au-ship-bar__track {
  height: 3px;
  background: var(--au-beige-dk);
  border-radius: var(--au-pill);
  overflow: hidden;
}
.au-ship-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, var(--au-gold), var(--au-gold-dk));
  border-radius: var(--au-pill);
  transition: width .6s ease;
}

/* ════════════════════════════════════════════════════
   SECTION 4 — BENEFIT ICONS
════════════════════════════════════════════════════ */
.au-benefits { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 48px 32px; }
.au-benefit {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16px;
}
.au-benefit__icon-wrap {
  width: 72px; height: 72px;
  border-radius: 50%;
  border: 1px solid var(--au-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 28px;
  background: #fff;
  transition: border-color .2s;
}
.au-benefit:hover .au-benefit__icon-wrap { border-color: var(--au-gold); }
.au-benefit__title {
  font-family: var(--au-serif);
  font-size: 18px;
  font-weight: 400;
  color: var(--au-text);
}
.au-benefit__text { font-size: 13px; color: var(--au-muted); max-width: 200px; }

/* ════════════════════════════════════════════════════
   SECTION 5 — BUNDLE SELECTOR
════════════════════════════════════════════════════ */
.au-bundles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}
.au-bundle-card {
  position: relative;
  border: 1.5px solid var(--au-border);
  border-radius: var(--au-radius);
  padding: 28px 24px;
  cursor: pointer;
  background: #fff;
  transition: border-color .2s, box-shadow .2s;
}
.au-bundle-card.is-selected {
  border-color: var(--au-gold);
  box-shadow: 0 0 0 3px rgba(184,154,94,.12);
}
.au-bundle-card__badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}
.au-bundle-card__name {
  font-family: var(--au-serif);
  font-size: 20px;
  font-weight: 400;
  margin-bottom: 6px;
  color: var(--au-text);
}
.au-bundle-card__units {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--au-muted);
  margin-bottom: 16px;
}
.au-bundle-card__price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; }
.au-bundle-card__price {
  font-family: var(--au-serif);
  font-size: 28px;
  font-weight: 300;
  color: var(--au-text);
}
.au-bundle-card__compare {
  font-size: 16px;
  color: var(--au-muted);
  text-decoration: line-through;
}
.au-bundle-card__per {
  font-size: 11px;
  color: var(--au-muted);
  letter-spacing: .06em;
  margin-bottom: 18px;
}
.au-bundle-card__perks { display: flex; flex-direction: column; gap: 8px; }
.au-bundle-card__perk {
  display: flex; align-items: center; gap: 8px;
  font-size: 13px; color: var(--au-muted-dk); font-weight: 300;
}
.au-bundle-card__perk::before { content: '—'; color: var(--au-gold); font-weight: 400; }

/* ════════════════════════════════════════════════════
   SECTION 6 — STICKY ATC
════════════════════════════════════════════════════ */
.au-sticky-atc {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 500;
  background: rgba(250,245,238,.96);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--au-border);
  padding: 14px 24px;
  display: flex;
  align-items: center;
  gap: 20px;
  transform: translateY(100%);
  transition: transform .3s cubic-bezier(.4,0,.2,1);
  box-shadow: 0 -8px 32px rgba(58,53,47,.08);
}
.au-sticky-atc.is-visible { transform: translateY(0); }
.au-sticky-atc__img {
  width: 52px; height: 52px;
  border-radius: var(--au-radius-sm);
  object-fit: cover; flex-shrink: 0;
  background: var(--au-beige);
}
.au-sticky-atc__info { flex: 1; min-width: 0; }
.au-sticky-atc__name {
  font-family: var(--au-serif);
  font-size: 16px; font-weight: 400;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.au-sticky-atc__price { font-size: 13px; color: var(--au-muted); font-weight: 300; }
.au-sticky-atc__btn { flex-shrink: 0; width: auto; padding: 14px 32px; font-size: 12px; }
@media (max-width: 600px) {
  .au-sticky-atc__img, .au-sticky-atc__info { display: none; }
  .au-sticky-atc__btn { width: 100%; }
}

/* ════════════════════════════════════════════════════
   SECTION 7 — REVIEWS / SOCIAL PROOF
════════════════════════════════════════════════════ */
.au-reviews-summary {
  display: flex;
  gap: 48px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 48px;
  padding: 36px;
  background: #fff;
  border: 1px solid var(--au-border);
  border-radius: var(--au-radius);
}
.au-reviews-summary__big {
  font-family: var(--au-serif);
  font-size: 72px;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -.02em;
  color: var(--au-text);
}
.au-reviews-summary__label { font-size: 12px; color: var(--au-muted); letter-spacing: .06em; margin-top: 6px; }
.au-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; font-size: 12px; color: var(--au-muted); }
.au-bar-row__track { flex: 1; height: 3px; background: var(--au-border); border-radius: var(--au-pill); overflow: hidden; }
.au-bar-row__fill { height: 100%; background: var(--au-gold); border-radius: var(--au-pill); }
.au-reviews-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
.au-review-card {
  background: #fff;
  border: 1px solid var(--au-border);
  border-radius: var(--au-radius);
  padding: 28px;
  display: flex; flex-direction: column; gap: 14px;
}
.au-review-card__top { display: flex; align-items: flex-start; justify-content: space-between; }
.au-review-card__author {
  font-family: var(--au-serif);
  font-size: 17px; font-weight: 400; color: var(--au-text);
}
.au-review-card__verified {
  font-size: 10px; font-weight: 500; letter-spacing: .1em;
  text-transform: uppercase; color: #3a5a40;
}
.au-review-card__headline {
  font-family: var(--au-serif);
  font-size: 19px; font-weight: 400; line-height: 1.3;
  color: var(--au-text);
}
.au-review-card__body { font-size: 13px; font-weight: 300; line-height: 1.75; color: var(--au-muted-dk); }
.au-review-card__img { width: 100%; height: 180px; object-fit: cover; border-radius: var(--au-radius-sm); }

/* ════════════════════════════════════════════════════
   SECTION 8 — HOW IT WORKS
════════════════════════════════════════════════════ */
.au-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 48px 32px; }
.au-step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
.au-step__num {
  font-family: var(--au-serif);
  font-size: 48px; font-weight: 300;
  color: var(--au-gold); line-height: 1;
}
.au-step__icon { font-size: 32px; }
.au-step__title { font-family: var(--au-serif); font-size: 20px; font-weight: 400; color: var(--au-text); }
.au-step__text { font-size: 13px; font-weight: 300; color: var(--au-muted); max-width: 220px; line-height: 1.7; }

/* ════════════════════════════════════════════════════
   SECTION 9 — BEFORE & AFTER
════════════════════════════════════════════════════ */
.au-ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; border-radius: var(--au-radius); overflow: hidden; max-width: 800px; margin: 0 auto; }
.au-ba-panel { position: relative; aspect-ratio: 4/5; }
.au-ba-panel img { width: 100%; height: 100%; object-fit: cover; display: block; }
.au-ba-panel__label {
  position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%);
  background: rgba(250,245,238,.92); backdrop-filter: blur(8px);
  padding: 6px 18px; border-radius: var(--au-pill);
  font-size: 10px; font-weight: 500; letter-spacing: .2em;
  text-transform: uppercase; color: var(--au-text); white-space: nowrap;
}

/* ════════════════════════════════════════════════════
   SECTION 10 — UGC VIDEOS
════════════════════════════════════════════════════ */
.au-ugc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
.au-ugc-card { position: relative; border-radius: var(--au-radius); overflow: hidden; cursor: pointer; }
.au-ugc-thumb { width: 100%; aspect-ratio: 9/16; object-fit: cover; display: block; background: var(--au-beige); }
.au-ugc-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(42,36,25,.7) 0%, transparent 55%);
  display: flex; flex-direction: column; justify-content: flex-end; padding: 16px;
  color: #fff;
}
.au-ugc-play {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 44px; height: 44px; border-radius: 50%;
  background: rgba(250,245,238,.9);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; color: var(--au-text);
  transition: transform .2s;
}
.au-ugc-card:hover .au-ugc-play { transform: translate(-50%, -50%) scale(1.1); }
.au-ugc-author { font-size: 12px; font-weight: 500; letter-spacing: .06em; }
.au-ugc-views { font-size: 11px; opacity: .7; }

/* ════════════════════════════════════════════════════
   SECTION 11 — COMPARISON TABLE
════════════════════════════════════════════════════ */
.au-comparison { border: 1px solid var(--au-border); border-radius: var(--au-radius); overflow: hidden; }
.au-comparison table { width: 100%; border-collapse: collapse; }
.au-comparison th, .au-comparison td {
  padding: 16px 24px;
  border-bottom: 1px solid var(--au-border);
  font-size: 13px; text-align: center;
}
.au-comparison th {
  font-family: var(--au-sans);
  font-size: 11px; font-weight: 500;
  letter-spacing: .14em; text-transform: uppercase;
  background: var(--au-beige-lt);
  color: var(--au-muted-dk);
}
.au-comparison th:first-child, .au-comparison td:first-child {
  text-align: left; font-weight: 400; color: var(--au-text);
}
.au-comparison .au-col--ours { background: rgba(184,154,94,.06); }
.au-comparison .au-col--ours th { color: var(--au-gold); }
.au-comparison tr:last-child td { border-bottom: none; }
.au-chk { color: var(--au-gold); font-size: 16px; font-weight: 600; }
.au-x { color: var(--au-beige-dk); font-size: 16px; }

/* ════════════════════════════════════════════════════
   SECTION 12 — WHAT'S INCLUDED
════════════════════════════════════════════════════ */
.au-included-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.au-included-img { width: 100%; border-radius: var(--au-radius); object-fit: cover; }
.au-included-list { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
.au-included-item {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 20px;
  border: 1px solid var(--au-border);
  border-radius: var(--au-radius-sm);
  background: #fff;
}
.au-included-item__icon { font-size: 24px; flex-shrink: 0; }
.au-included-item__name { font-size: 14px; font-weight: 400; color: var(--au-text); }
.au-included-item__desc { font-size: 12px; font-weight: 300; color: var(--au-muted); }

/* ════════════════════════════════════════════════════
   SECTION 13 — GUARANTEE
════════════════════════════════════════════════════ */
.au-guarantee { display: flex; gap: 48px; justify-content: center; flex-wrap: wrap; }
.au-guarantee__item {
  display: flex; flex-direction: column; align-items: center;
  gap: 14px; flex: 1 1 160px; text-align: center;
}
.au-guarantee__icon { font-size: 36px; }
.au-guarantee__title {
  font-family: var(--au-serif);
  font-size: 20px; font-weight: 400; color: var(--au-text);
}
.au-guarantee__text { font-size: 13px; font-weight: 300; color: var(--au-muted); max-width: 160px; line-height: 1.6; }

/* ════════════════════════════════════════════════════
   SECTION 14 — FAQ
════════════════════════════════════════════════════ */
.au-faqs { max-width: 720px; margin: 0 auto; }
.au-faq { border-bottom: 1px solid var(--au-border); }
.au-faq__trigger {
  width: 100%; background: none; border: none;
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
  padding: 22px 0;
  font-family: var(--au-serif); font-size: 20px; font-weight: 400;
  color: var(--au-text); text-align: left; cursor: pointer;
  font-style: normal;
}
.au-faq__icon {
  flex-shrink: 0; width: 28px; height: 28px;
  border-radius: 50%; border: 1px solid var(--au-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: var(--au-text);
  transition: transform .3s, background .2s, border-color .2s;
}
.au-faq.is-open .au-faq__icon {
  transform: rotate(45deg);
  background: var(--au-gold);
  border-color: var(--au-gold);
  color: #fff;
}
.au-faq__body { max-height: 0; overflow: hidden; transition: max-height .35s ease, padding .2s; }
.au-faq.is-open .au-faq__body { max-height: 600px; padding-bottom: 22px; }
.au-faq__answer { font-size: 14px; font-weight: 300; line-height: 1.8; color: var(--au-muted-dk); }

/* ════════════════════════════════════════════════════
   SECTION 15 — FINAL CTA
════════════════════════════════════════════════════ */
.au-final-cta {
  text-align: center;
  display: flex; flex-direction: column; align-items: center;
  gap: 28px; padding: 100px 24px;
}
.au-final-cta .au-h2 { color: var(--au-cream); max-width: 640px; }
.au-final-cta__sub { font-size: 15px; font-weight: 300; color: rgba(250,245,238,.6); max-width: 440px; }
.au-final-cta__actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
.au-final-cta__actions .au-btn { width: auto; }
.au-final-cta__small { font-size: 11px; letter-spacing: .1em; color: rgba(250,245,238,.38); text-transform: uppercase; }

/* ════════════════════════════════════════════════════
   VIDEO MODAL
════════════════════════════════════════════════════ */
.au-modal {
  display: none; position: fixed; inset: 0; z-index: 900;
  background: rgba(26,22,18,.88); backdrop-filter: blur(8px);
  align-items: center; justify-content: center; padding: 20px;
}
.au-modal.is-open { display: flex; }
.au-modal__close {
  position: absolute; top: 20px; right: 20px;
  width: 44px; height: 44px; border-radius: 50%;
  background: rgba(250,245,238,.15); border: none;
  color: #fff; font-size: 20px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.au-modal__inner { max-width: 480px; width: 100%; aspect-ratio: 9/16; }
.au-modal__inner iframe, .au-modal__inner video {
  width: 100%; height: 100%; border: none; border-radius: var(--au-radius);
}

/* ════════════════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════════════════ */
@media (max-width: 900px) {
  .au-hero { grid-template-columns: 1fr; gap: 36px; padding-top: 24px; }
  .au-gallery { grid-template-columns: 1fr; position: static; }
  .au-gallery__thumbs { flex-direction: row; overflow-x: auto; }
  .au-gallery__thumb { flex-shrink: 0; }
  .au-trust-strip { grid-template-columns: 1fr 1fr; }
  .au-trust-strip__item:nth-child(2) { border-right: none; }
  .au-included-layout { grid-template-columns: 1fr; }
  .au-ba-grid { grid-template-columns: 1fr; }
  .au-comparison { overflow-x: auto; }
  .au-comparison table { min-width: 480px; }
}
@media (max-width: 560px) {
  .au-reviews-summary { flex-direction: column; }
  .au-trust-strip { grid-template-columns: 1fr; }
  .au-trust-strip__item { border-right: none; border-bottom: 1px solid var(--au-border); }
  .au-trust-strip__item:last-child { border-bottom: none; }
  .au-final-cta { padding: 72px 20px; }
  .au-bundles { grid-template-columns: 1fr; }
}
</style>

<div id="au-{{ section.id }}">

  {%- comment %} ══ 1+2. HERO + GALLERY ══════════════════════════ {% endcomment %}
  <div class="au-container">
    <div class="au-hero">

      {%- comment %} Gallery ─ {% endcomment %}
      <div class="au-gallery" aria-label="Product images">
        <div class="au-gallery__thumbs" role="list">
          {%- if section.settings.product_image != blank -%}
            <button class="au-gallery__thumb is-active" role="listitem" data-au-thumb data-src="{{ section.settings.product_image | img_url: '900x900', crop: 'center' }}" aria-label="Image 1">
              <img src="{{ section.settings.product_image | img_url: '150x150', crop: 'center' }}" alt="" loading="lazy" width="72" height="72">
            </button>
          {%- elsif product.featured_image -%}
            {%- for img in product.images limit: 6 -%}
              <button class="au-gallery__thumb{% if forloop.first %} is-active{% endif %}" role="listitem" data-au-thumb data-src="{{ img | img_url: '900x900', crop: 'center' }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ img | img_url: '150x150', crop: 'center' }}" alt="{{ img.alt | escape }}" loading="lazy" width="72" height="72">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="au-gallery__main-wrap">
          {%- if section.settings.badge_text != blank -%}
            <div class="au-gallery__badge-wrap">
              <span class="au-badge au-badge--dark">{{ section.settings.badge_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.product_image != blank -%}
            <img id="au-main-img-{{ section.id }}" class="au-gallery__main"
              src="{{ section.settings.product_image | img_url: '900x900', crop: 'center' }}"
              alt="{{ product.title | escape }}" width="900" height="900" loading="eager">
          {%- elsif product.featured_image -%}
            <img id="au-main-img-{{ section.id }}" class="au-gallery__main"
              src="{{ product.featured_image | img_url: '900x900', crop: 'center' }}"
              alt="{{ product.title | escape }}" width="900" height="900" loading="eager">
          {%- else -%}
            <div class="au-gallery__main" style="background:var(--au-beige-lt);display:flex;align-items:center;justify-content:center;color:var(--au-muted);font-size:13px;" aria-hidden="true">No image</div>
          {%- endif -%}
        </div>
      </div>

      {%- comment %} Info panel ─ {% endcomment %}
      <div class="au-hero__info">

        {%- if section.settings.eyebrow != blank -%}
          <p class="au-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="au-h1">{{ section.settings.heading | default: product.title }}</h1>

        {%- if section.settings.subheading != blank -%}
          <p style="font-size:16px;font-weight:300;color:var(--au-muted-dk);line-height:1.65;">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- comment %} 3. RATING ─ {% endcomment %}
        <div class="au-hero__meta">
          <span class="au-stars" aria-label="{{ section.settings.review_rating | default: '4.9' }} stars">★★★★★</span>
          <span class="au-hero__rating-label">{{ section.settings.review_rating | default: '4.9' }} · {{ section.settings.review_count | default: '2,847 reviews' }}</span>
        </div>

        {%- comment %} Price ─ {% endcomment %}
        <div class="au-hero__price-row">
          <span class="au-hero__price" id="au-price-{{ section.id }}">
            {%- if current_variant.price -%}{{ current_variant.price | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="au-hero__compare">{{ current_variant.compare_at_price | money }}</span>
            {%- assign saved = current_variant.compare_at_price | minus: current_variant.price -%}
            <span class="au-hero__save">Save {{ saved | money }}</span>
          {%- elsif product.compare_at_price > product.price -%}
            <span class="au-hero__compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- comment %} Product form ─ {% endcomment %}
        {%- form 'product', product, id: product_form_id -%}

          {%- unless product.has_only_default_variant -%}
            <div class="au-variants">
              {%- for option in product.options_with_values -%}
                <div>
                  <p class="au-variants__label">{{ option.name }}: <strong style="color:var(--au-text);font-weight:500;">{{ option.selected_value }}</strong></p>
                  <div class="au-variants__options" role="radiogroup" aria-label="{{ option.name }}">
                    {%- for value in option.values -%}
                      <label>
                        <input type="radio" name="{{ option.name }}" value="{{ value | escape }}" data-au-option="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %} style="display:none;">
                        <span class="au-variants__btn{% if option.selected_value == value %} is-active{% endif %}" tabindex="0" role="radio" aria-checked="{{ option.selected_value == value }}">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
              <input type="hidden" name="id" id="au-variant-{{ section.id }}" value="{{ current_variant.id }}">
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endunless -%}

          {%- comment %} Qty ─ {% endcomment %}
          <div class="au-qty">
            <p class="au-qty__label">Quantity</p>
            <div class="au-qty__row">
              <div class="au-qty__stepper">
                <button type="button" class="au-qty__btn" data-au-minus aria-label="Decrease quantity">−</button>
                <input type="number" class="au-qty__input" id="au-qty-{{ section.id }}" name="quantity" value="1" min="1" aria-label="Quantity">
                <button type="button" class="au-qty__btn" data-au-plus aria-label="Increase quantity">+</button>
              </div>
            </div>
          </div>

          {%- comment %} CTA ─ {% endcomment %}
          <div class="au-hero__cta">
            <button type="submit" name="add" id="au-atc-{{ section.id }}"
              class="au-btn au-hero__atc"
              {%- unless current_variant.available -%} disabled aria-disabled="true" {%- endunless -%}
              aria-label="Add {{ product.title | escape }} to cart">
              {%- if current_variant.available -%}
                {{ section.settings.atc_text | default: 'Add to Cart' }}
              {%- else -%}Sold Out{%- endif -%}
            </button>
            {%- if section.settings.show_dynamic_checkout -%}
              <div class="au-hero__dynamic">{{ form | payment_button }}</div>
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- comment %} Shipping bar ─ {% endcomment %}
        {%- if section.settings.show_shipping_bar -%}
          {%- assign price_cents = current_variant.price | default: product.price -%}
          {%- assign threshold = 5000 -%}
          {%- assign pct = price_cents | times: 100 | divided_by: threshold -%}
          {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
          <div class="au-ship-bar">
            {%- if pct >= 100 -%}
              <p class="au-ship-bar__label">🎉 You've unlocked <strong>Free Shipping</strong></p>
            {%- else -%}
              <p class="au-ship-bar__label">Add <strong>{{ threshold | minus: price_cents | money }}</strong> more for free shipping</p>
            {%- endif -%}
            <div class="au-ship-bar__track" role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
              <div class="au-ship-bar__fill" style="width:{{ pct }}%;"></div>
            </div>
          </div>
        {%- endif -%}

        {%- comment %} Trust strip ─ {% endcomment %}
        <div class="au-trust-strip" aria-label="Trust signals">
          <div class="au-trust-strip__item"><span class="au-trust-strip__icon" aria-hidden="true">🔒</span>Secure Checkout</div>
          <div class="au-trust-strip__item"><span class="au-trust-strip__icon" aria-hidden="true">📦</span>Free Shipping $50+</div>
          <div class="au-trust-strip__item"><span class="au-trust-strip__icon" aria-hidden="true">↩️</span>30-Day Returns</div>
          <div class="au-trust-strip__item"><span class="au-trust-strip__icon" aria-hidden="true">⭐</span>Verified Reviews</div>
        </div>

      </div>
    </div>
  </div>

  {%- comment %} ══ 4. BENEFIT ICONS ════════════════════════════ {% endcomment %}
  {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit_item' -%}
  {%- if benefit_blocks.size > 0 -%}
    <div class="au-section au-section--beige">
      <div class="au-container">
        {%- if section.settings.benefits_heading != blank -%}
          <div class="au-section-head">
            <p class="au-eyebrow">{{ section.settings.benefits_eyebrow }}</p>
            <div class="au-divider"></div>
            <h2 class="au-h2">{{ section.settings.benefits_heading }}</h2>
            {%- if section.settings.benefits_sub != blank -%}<p>{{ section.settings.benefits_sub }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        <div class="au-benefits" role="list">
          {%- for block in benefit_blocks -%}
            <div class="au-benefit" role="listitem" {{ block.shopify_attributes }}>
              <div class="au-benefit__icon-wrap" aria-hidden="true">{{ block.settings.icon | default: '✨' }}</div>
              <p class="au-benefit__title">{{ block.settings.title }}</p>
              <p class="au-benefit__text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment %} ══ 5. BUNDLE SELECTOR ══════════════════════════ {% endcomment %}
  {%- assign bundle_blocks = section.blocks | where: 'type', 'bundle_offer' -%}
  {%- if bundle_blocks.size > 0 -%}
    <div class="au-section">
      <div class="au-container">
        <div class="au-section-head">
          <p class="au-eyebrow">{{ section.settings.bundle_eyebrow | default: 'Bundle & Save' }}</p>
          <div class="au-divider"></div>
          <h2 class="au-h2">{{ section.settings.bundle_heading | default: 'Choose Your Kit' }}</h2>
          {%- if section.settings.bundle_sub != blank -%}<p>{{ section.settings.bundle_sub }}</p>{%- endif -%}
        </div>
        <div class="au-bundles" role="list">
          {%- for block in bundle_blocks -%}
            <div class="au-bundle-card{% if forloop.first %} is-selected{% endif %}" role="listitem" tabindex="0" data-au-bundle {{ block.shopify_attributes }}>
              {%- if block.settings.badge_label != blank -%}
                <div class="au-bundle-card__badge">
                  <span class="au-badge {% if block.settings.badge_style == 'green' %}au-badge--green{% else %}au-badge--gold{% endif %}">{{ block.settings.badge_label }}</span>
                </div>
              {%- endif -%}
              <p class="au-bundle-card__name">{{ block.settings.name }}</p>
              <p class="au-bundle-card__units">{{ block.settings.units }}</p>
              <div class="au-bundle-card__price-row">
                <span class="au-bundle-card__price">{{ block.settings.price }}</span>
                {%- if block.settings.compare_price != blank -%}
                  <span class="au-bundle-card__compare">{{ block.settings.compare_price }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.per != blank -%}
                <p class="au-bundle-card__per">{{ block.settings.per }}</p>
              {%- endif -%}
              <div class="au-bundle-card__perks">
                {%- if block.settings.perk_1 != blank -%}<p class="au-bundle-card__perk">{{ block.settings.perk_1 }}</p>{%- endif -%}
                {%- if block.settings.perk_2 != blank -%}<p class="au-bundle-card__perk">{{ block.settings.perk_2 }}</p>{%- endif -%}
                {%- if block.settings.perk_3 != blank -%}<p class="au-bundle-card__perk">{{ block.settings.perk_3 }}</p>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment %} ══ 7. SOCIAL PROOF / REVIEWS ═══════════════════ {% endcomment %}
  {%- assign review_blocks = section.blocks | where: 'type', 'review_item' -%}
  {%- if review_blocks.size > 0 -%}
    <div class="au-section au-section--beige">
      <div class="au-container">
        <div class="au-section-head">
          <p class="au-eyebrow">{{ section.settings.reviews_eyebrow | default: 'Verified Reviews' }}</p>
          <div class="au-divider"></div>
          <h2 class="au-h2">{{ section.settings.reviews_heading | default: 'What Our Customers Say' }}</h2>
        </div>
        <div class="au-reviews-summary">
          <div style="text-align:center;flex-shrink:0;">
            <p class="au-reviews-summary__big">{{ section.settings.review_rating | default: '4.9' }}</p>
            <div class="au-stars au-stars--lg" aria-hidden="true">★★★★★</div>
            <p class="au-reviews-summary__label">{{ section.settings.review_count | default: '2,847 reviews' }}</p>
          </div>
          <div style="flex:1;min-width:200px;">
            {%- assign pct_data = '96,90,76,52,30' | split: ',' -%}
            {%- assign star_labels = '5 stars,4 stars,3 stars,2 stars,1 star' | split: ',' -%}
            {%- for p in pct_data -%}
              <div class="au-bar-row">
                <span style="width:46px;">{{ star_labels[forloop.index0] }}</span>
                <div class="au-bar-row__track"><div class="au-bar-row__fill" style="width:{{ p }}%;"></div></div>
                <span>{{ p }}%</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
        <div class="au-reviews-grid" role="list">
          {%- for block in review_blocks -%}
            <article class="au-review-card" role="listitem" {{ block.shopify_attributes }}>
              <div class="au-review-card__top">
                <span class="au-review-card__author">{{ block.settings.author | default: 'Verified Buyer' }}</span>
                <span class="au-review-card__verified">✓ Verified</span>
              </div>
              <div class="au-stars" aria-label="{{ block.settings.rating | default: 5 }} out of 5">
                {%- assign rv = block.settings.rating | default: 5 | round -%}
                {%- for i in (1..5) -%}{%- if i <= rv -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
              </div>
              {%- if block.settings.headline != blank -%}
                <p class="au-review-card__headline">{{ block.settings.headline }}</p>
              {%- endif -%}
              <p class="au-review-card__body">{{ block.settings.body }}</p>
              {%- if block.settings.image != blank -%}
                <img class="au-review-card__img" src="{{ block.settings.image | img_url: '400x300', crop: 'center' }}" alt="Review photo by {{ block.settings.author | escape }}" loading="lazy" width="400" height="300">
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment %} ══ 8. HOW IT WORKS ═════════════════════════════ {% endcomment %}
  {%- assign step_blocks = section.blocks | where: 'type', 'how_it_works_step' -%}
  {%- if step_blocks.size > 0 -%}
    <div class="au-section">
      <div class="au-container">
        <div class="au-section-head">
          <p class="au-eyebrow">{{ section.settings.hiw_eyebrow | default: 'The Method' }}</p>
          <div class="au-divider"></div>
          <h2 class="au-h2">{{ section.settings.hiw_heading | default: 'How It Works' }}</h2>
          {%- if section.settings.hiw_sub != blank -%}<p>{{ section.settings.hiw_sub }}</p>{%- endif -%}
        </div>
        <div class="au-steps" role="list">
          {%- for block in step_blocks -%}
            <div class="au-step" role="listitem" {{ block.shopify_attributes }}>
              <span class="au-step__num" aria-hidden="true">0{{ forloop.index }}</span>
              {%- if block.settings.icon != blank -%}
                <span class="au-step__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
