<section class="trust"><div class="trust__inner">
  {% for block in section.blocks %}<div class="trust__item" {{ block.shopify_attributes }}>{% render 'icon', icon: block.settings.icon %}<span>{{ block.settings.text }}</span></div>{% endfor %}
</div></section>
{% schema %}
{ "name": "Trust bar", "blocks": [ { "type": "item", "name": "Item", "settings": [
  { "type": "select", "id": "icon", "label": "Icon", "options": [ {"value":"cart","label":"Shipping"},{"value":"shield","label":"Shield"},{"value":"leaf","label":"Leaf"},{"value":"star","label":"Star"},{"value":"check","label":"Check"} ], "default": "shield" },
  { "type": "text", "id": "text", "label": "Text", "default": "90-Day Guarantee" } ] } ],
  "max_blocks": 4, "presets": [ { "name": "Trust bar", "blocks": [ {"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"} ] } ] }
{% endschema %}