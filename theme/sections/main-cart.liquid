<section class="section"><div class="wrap" style="max-width:900px;">
  <div class="sec-head center"><h1 class="display-md">Your Bag</h1></div>
  <form action="{{ routes.cart_url }}" method="post" novalidate>
    {% if cart.item_count == 0 %}<p class="center lede">Your bag is empty. <a href="{{ routes.root_url }}" class="link-underline">Continue shopping</a></p>{% else %}
    {% for item in cart.items %}
      <div class="cart-item" style="grid-template-columns:96px 1fr auto;padding:24px 0;">
        <div class="cart-item__img" style="width:96px;height:118px;"><img src="{{ item.image | image_url: width: 200 }}" alt="" style="width:100%;height:100%;object-fit:cover;"></div>
        <div><div class="cart-item__name">{{ item.product.title }}</div><div class="cart-item__var">{{ item.variant.title }}</div></div>
        <div style="text-align:right;"><div class="cart-item__price">{{ item.final_line_price | money }}</div></div>
      </div>
    {% endfor %}
    <div class="cart__row cart__row--total" style="margin-top:20px;"><span class="l">Subtotal</span><span class="v">{{ cart.total_price | money }}</span></div>
    <button type="submit" name="checkout" class="btn btn--primary btn--block" style="margin-top:18px;padding:18px;">Checkout</button>
    {% endif %}
  </form>
</div></section>
{% schema %}{ "name": "Cart", "settings": [] }{% endschema %}