<section class="page-hero"><div class="wrap"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1 class="display-md">{{ section.settings.heading }}</h1></div></section>
<section class="section"><div class="wrap"><div class="prose">{{ section.settings.text }}</div></div></section>
{% schema %}
{ "name": "Rich text", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Auvelle" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
  { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Add your content here.</p>" }
], "presets": [ { "name": "Rich text" } ] }
{% endschema %}