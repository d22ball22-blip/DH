<section class="section" id="gallery"><div class="wrap">
  <div class="sec-head center reveal"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="display-md">{{ section.settings.heading }}</h2></div>
  <div class="ig-grid reveal">
    {% for block in section.blocks %}<a class="ig-tile" href="{{ block.settings.link | default: settings.social_instagram }}" {{ block.shopify_attributes }}><img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 600 }}{% else %}{{ 'ig1.jpg' | asset_url }}{% endif %}" alt="" loading="lazy" style="aspect-ratio:1/1;object-fit:cover;"><div class="ig-tile__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></div></a>{% endfor %}
  </div>
</div></section>
{% schema %}
{ "name": "Gallery", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@auvellebeauty" },
  { "type": "html", "id": "heading", "label": "Heading", "default": "Join the <em class='serif-it'>glow</em> community." }
], "blocks": [ { "type": "tile", "name": "Tile", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "url", "id": "link", "label": "Link" } ] } ],
  "max_blocks": 12, "presets": [ { "name": "Gallery", "blocks": [ {"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"} ] } ] }
{% endschema %}