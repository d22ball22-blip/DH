<script>
(function() {
  var sectionId = '{{ section.id }}';
  var variantPrice = {{ current_variant.price }};
  var variantCompare = {{ current_variant.compare_at_price | default: 0 }};
  var bumpProductHandle = '{{ section.settings.bump_product }}';
  var bumpVariantId = null;
  var bumpPrice = 0;

  {%- if section.settings.bump_product != blank -%}
    {%- assign bump_prod = all_products[section.settings.bump_product] -%}
    {%- if bump_prod != blank -%}
      bumpVariantId = {{ bump_prod.selected_or_first_available_variant.id }};
      bumpPrice = {{ bump_prod.price }};
    {%- endif -%}
  {%- endif -%}

  var qty = 1;
  var packQty = 1;
  var bumpChecked = false;

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function updateTotalLine() {
    var totalEl = document.getElementById('pf-total-line-' + sectionId);
    if (!totalEl) return;
    var mainTotal = variantPrice * packQty * qty;
    var bumpTotal = bumpChecked && bumpVariantId ? bumpPrice : 0;
    var grand = mainTotal + bumpTotal;
    if (grand > 0) {
      totalEl.innerHTML = 'Order total: <strong>' + formatMoney(grand) + '</strong>';
    } else {
      totalEl.innerHTML = '';
    }
  }

  // Gallery
  var thumbsWrap = document.getElementById('pf-thumbs-' + sectionId);
  var mainImg = document.getElementById('pf-main-img-' + sectionId);
  if (thumbsWrap && mainImg) {
    var thumbs = thumbsWrap.querySelectorAll('.pf-thumb');
    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        thumbs.forEach(function(t) { t.classList.remove('active'); });
        thumb.classList.add('active');
        var src = thumb.getAttribute('data-src');
        mainImg.style.opacity = '0';
        setTimeout(function() {
          mainImg.src = src;
          mainImg.style.opacity = '1';
        }, 150);
      });
    });
  }

  // Pack Selector
  var packsWrap = document.getElementById('pf-packs-' + sectionId);
  if (packsWrap) {
    var packOptions = packsWrap.querySelectorAll('.pf-pack-option');
    packOptions.forEach(function(opt) {
      opt.addEventListener('click', function() {
        packOptions.forEach(function(p) { p.classList.remove('selected'); });
        opt.classList.add('selected');
        packQty = parseInt(opt.getAttribute('data-qty'), 10) || 1;
        updateTotalLine();
      });
    });
  }

  // Qty +/-
  var qtyVal = document.getElementById('pf-qty-val-' + sectionId);
  var qtyMinus = document.getElementById('pf-qty-minus-' + sectionId);
  var qtyPlus = document.getElementById('pf-qty-plus-' + sectionId);

  if (qtyMinus && qtyPlus && qtyVal) {
    qtyMinus.addEventListener('click', function() {
      if (qty > 1) {
        qty--;
        qtyVal.textContent = qty;
        updateTotalLine();
      }
    });
    qtyPlus.addEventListener('click', function() {
      qty++;
      qtyVal.textContent = qty;
      updateTotalLine();
    });
  }

  // Order Bump
  var bumpEl = document.getElementById('pf-bump-' + sectionId);
  if (bumpEl) {
    bumpEl.addEventListener('click', function() {
      bumpChecked = !bumpChecked;
      bumpEl.classList.toggle('checked', bumpChecked);
      updateTotalLine();
    });
  }

  updateTotalLine();

  // Add to Cart
  var form = document.getElementById('pf-form-' + sectionId);
  var atcBtn = document.getElementById('pf-atc-' + sectionId);
  var atcText = document.getElementById('pf-atc-text-' + sectionId);
  var variantIdInput = document.getElementById('pf-variant-id-' + sectionId);

  if (form && atcBtn) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var variantId = variantIdInput ? parseInt(variantIdInput.value, 10) : null;
      if (!variantId) {
        window.location = '/cart';
        return;
      }

      var items = [{ id: variantId, quantity: packQty * qty }];
      if (bumpChecked && bumpVariantId) {
        items.push({ id: bumpVariantId, quantity: 1 });
      }

      atcBtn.classList.add('loading');
      if (atcText) atcText.textContent = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        atcBtn.classList.remove('loading');
        if (atcText) atcText.textContent = 'Add to Cart';

        // Try cart drawer or notification
        var cartDrawer = document.querySelector('cart-drawer');
        var cartNotification = document.querySelector('cart-notification');

        if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open();
        } else if (cartNotification && typeof cartNotification.open === 'function') {
          cartNotification.open();
        } else {
          // Dispatch event for theme cart handlers
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          // Fallback: check if any cart drawer element responds
          var drawerEl = document.getElementById('CartDrawer') || document.getElementById('cart-drawer');
          if (drawerEl) {
            drawerEl.setAttribute('open', '');
          } else {
            window.location = '/cart';
          }
        }
      })
      .catch(function(err) {
        atcBtn.classList.remove('loading');
        if (atcText) atcText.textContent = 'Add to Cart';
        console.error('Cart add error:', err);
        window.location = '/cart';
      });
    });
  }

  // Accordion
  var accordionEl = document.getElementById('pf-accordion-' + sectionId);
  if (accordionEl) {
    accordionEl.querySelectorAll('.pf-accordion-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        var item = trigger.closest('.pf-accordion-item');
        if (!item) return;
        var isOpen = item.classList.contains('open');
        accordionEl.querySelectorAll('.pf-accordion-item').forEach(function(i) { i.classList.remove('open'); });
        if (!isOpen) item.classList.add('open');
      });
    });
  }

  // Countdown Timer
  {%- if section.settings.show_countdown -%}
  (function() {
    var hoursToRun = {{ section.settings.countdown_hours | default: 4 }};
    var storageKey = 'pf_countdown_end_' + sectionId;
    var timerEl = document.getElementById('pf-timer-' + sectionId);
    if (!timerEl) return;

    var endTime;
    var stored = localStorage.getItem(storageKey);
    if (stored) {
      endTime = parseInt(stored, 10);
      if (Date.now() > endTime) {
        endTime = Date.now() + hoursToRun * 3600 * 1000;
        localStorage.setItem(storageKey, endTime);
      }
    } else {
      endTime = Date.now() + hoursToRun * 3600 * 1000;
      localStorage.setItem(storageKey, endTime);
    }

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var diff = endTime - Date.now();
      if (diff <= 0) {
        timerEl.textContent = '00:00:00';
        return;
      }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      timerEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
      setTimeout(tick, 1000);
    }
    tick();
  })();
  {%- endif -%}

})();
</script>

