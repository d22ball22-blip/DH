{%- style -%}
  #shopify-section-{{ section.id }} {
    --pf-green: #2F7D4F;
    --pf-deep: #235E3A;
    --pf-soft: #D8E9DD;
    --pf-cream: #EAF2EC;
    --pf-sand: #F5F4EF;
    --pf-ink: #141414;
    --pf-muted: #6e6e68;
    --pf-star: #E0A93B;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .pf-countdown-bar {
    background: var(--pf-deep);
    color: #fff;
    text-align: center;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pf-countdown-badge {
    background: var(--pf-star);
    color: #141414;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .pf-countdown-timer {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  #shopify-section-{{ section.id }} .pf-main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .pf-main-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px 16px;
    }
  }

  /* Gallery */
  #shopify-section-{{ section.id }} .pf-gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .pf-gallery-main {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--pf-cream);
    aspect-ratio: 1 / 1;
  }

  #shopify-section-{{ section.id }} .pf-gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pf-gallery-thumbs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pf-thumb {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pf-thumb.active,
  #shopify-section-{{ section.id }} .pf-thumb:hover {
    border-color: var(--pf-green);
  }

  #shopify-section-{{ section.id }} .pf-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Buy Box */
  #shopify-section-{{ section.id }} .pf-buybox {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .pf-stars-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .pf-stars {
    color: var(--pf-star);
    font-size: 16px;
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .pf-rating-text {
    font-weight: 700;
    color: var(--pf-ink);
  }

  #shopify-section-{{ section.id }} .pf-rating-note {
    color: var(--pf-muted);
  }

  #shopify-section-{{ section.id }} .pf-product-title {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    color: var(--pf-ink);
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .pf-subheading {
    font-size: 15px;
    color: var(--pf-muted);
    margin: 0;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .pf-price-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pf-price {
    font-size: 28px;
    font-weight: 800;
    color: var(--pf-deep);
  }

  #shopify-section-{{ section.id }} .pf-compare {
    font-size: 18px;
    color: var(--pf-muted);
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .pf-save-pill {
    background: var(--pf-soft);
    color: var(--pf-deep);
    border-radius: 20px;
    padding: 3px 10px;
    font-size: 13px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pf-social-proof {
    font-size: 13px;
    color: var(--pf-green);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .pf-social-proof::before {
    content: '🔥';
  }

  #shopify-section-{{ section.id }} .pf-bullets {
    font-size: 14px;
    color: var(--pf-ink);
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .pf-bullets ul {
    margin: 0;
    padding-left: 20px;
  }

  #shopify-section-{{ section.id }} .pf-bullets li {
    margin-bottom: 4px;
  }

  /* Pack Selector */
  #shopify-section-{{ section.id }} .pf-pack-label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pf-muted);
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .pf-packs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .pf-pack-option {
    border: 2px solid #e0e0da;
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }

  #shopify-section-{{ section.id }} .pf-pack-option.selected {
    border-color: var(--pf-green);
    background: var(--pf-cream);
  }

  #shopify-section-{{ section.id }} .pf-pack-option:hover {
    border-color: var(--pf-green);
  }

  #shopify-section-{{ section.id }} .pf-pack-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.2s;
  }

  #shopify-section-{{ section.id }} .pf-pack-option.selected .pf-pack-radio {
    border-color: var(--pf-green);
    background: var(--pf-green);
  }

  #shopify-section-{{ section.id }} .pf-pack-option.selected .pf-pack-radio::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    display: block;
  }

  #shopify-section-{{ section.id }} .pf-pack-info {
    flex: 1;
    padding: 0 12px;
  }

  #shopify-section-{{ section.id }} .pf-pack-name {
    font-weight: 700;
    font-size: 15px;
    color: var(--pf-ink);
  }

  #shopify-section-{{ section.id }} .pf-pack-sub {
    font-size: 13px;
    color: var(--pf-muted);
    margin-top: 2px;
  }

  #shopify-section-{{ section.id }} .pf-pack-tag {
    background: var(--pf-star);
    color: #141414;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Order Bump */
  #shopify-section-{{ section.id }} .pf-order-bump {
    border: 2px dashed var(--pf-green);
    border-radius: 12px;
    padding: 14px 16px;
    background: var(--pf-cream);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .pf-bump-checkbox {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid var(--pf-green);
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  #shopify-section-{{ section.id }} .pf-order-bump.checked .pf-bump-checkbox {
    background: var(--pf-green);
  }

  #shopify-section-{{ section.id }} .pf-order-bump.checked .pf-bump-checkbox::after {
    content: '✓';
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pf-bump-img {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pf-bump-text .pf-bump-add {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pf-green);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pf-bump-text .pf-bump-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--pf-ink);
  }

  #shopify-section-{{ section.id }} .pf-bump-text .pf-bump-sub {
    font-size: 13px;
    color: var(--pf-muted);
    margin-top: 2px;
  }

  /* Qty + ATC */
  #shopify-section-{{ section.id }} .pf-qty-atc {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .pf-qty-wrap {
    display: flex;
    align-items: center;
    border: 2px solid #e0e0da;
    border-radius: 10px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .pf-qty-btn {
    background: none;
    border: none;
    width: 40px;
    height: 48px;
    font-size: 20px;
    cursor: pointer;
    color: var(--pf-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  #shopify-section-{{ section.id }} .pf-qty-btn:hover {
    background: var(--pf-soft);
  }

  #shopify-section-{{ section.id }} .pf-qty-val {
    width: 40px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: var(--pf-ink);
  }

  #shopify-section-{{ section.id }} .pf-atc-btn {
    flex: 1;
    background: var(--pf-green);
    color: #fff;
    border: none;
    border-radius: 10px;
    height: 52px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s, transform 0.15s;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .pf-atc-btn:hover {
    background: var(--pf-deep);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .pf-atc-btn:active {
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .pf-atc-btn.loading {
    opacity: 0.75;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .pf-total-line {
    font-size: 13px;
    color: var(--pf-muted);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pf-total-line strong {
    color: var(--pf-ink);
  }

  /* Trust Strip */
  #shopify-section-{{ section.id }} .pf-trust-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding-top: 4px;
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .pf-trust-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .pf-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    padding: 10px 4px;
    background: var(--pf-cream);
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .pf-trust-icon {
    font-size: 22px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .pf-trust-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--pf-ink);
    line-height: 1.3;
  }

  /* Update Note */
  #shopify-section-{{ section.id }} .pf-update-note {
    background: var(--pf-soft);
    border-left: 4px solid var(--pf-green);
    border-radius: 0 8px 8px 0;
    padding: 10px 14px;
    font-size: 13px;
    color: var(--pf-deep);
    font-weight: 500;
  }

  /* Accordion */
  #shopify-section-{{ section.id }} .pf-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #e0e0da;
  }

  #shopify-section-{{ section.id }} .pf-accordion-item {
    border-bottom: 1px solid #e0e0da;
  }

  #shopify-section-{{ section.id }} .pf-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    color: var(--pf-ink);
    background: none;
    border: none;
    width: 100%;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pf-accordion-icon {
    font-size: 18px;
    color: var(--pf-green);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pf-accordion-body {
    font-size: 14px;
    color: var(--pf-muted);
    line-height: 1.7;
    padding-bottom: 14px;
    display: none;
  }

  #shopify-section-{{ section.id }} .pf-accordion-body p {
    margin: 0 0 8px;
  }

  #shopify-section-{{ section.id }} .pf-accordion-body p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .pf-accordion-item.open .pf-accordion-body {
    display: block;
  }

  #shopify-section-{{ section.id }} .pf-accordion-item.open .pf-accordion-icon {
    transform: rotate(45deg);
  }

  /* Marquee */
  #shopify-section-{{ section.id }} .pf-marquee-bar {
    background: var(--pf-deep);
    color: #fff;
    overflow: hidden;
    padding: 10px 0;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pf-marquee-track {
    display: inline-flex;
    animation: pf-marquee-scroll 22s linear infinite;
  }

  #shopify-section-{{ section.id }} .pf-marquee-segment {
    padding-right: 60px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @keyframes pf-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- if section.settings.show_countdown -%}
<div class="pf-countdown-bar">
  {%- if section.settings.save_badge != blank -%}
    <span class="pf-countdown-badge">{{ section.settings.save_badge }}</span>
  {%- endif -%}
  <span>Offer ends in&nbsp;<span class="pf-countdown-timer" id="pf-timer-{{ section.id }}">--:--:--</span></span>
</div>
{%- endif -%}

<div class="pf-main-grid">
  <!-- Gallery -->
  <div class="pf-gallery">
    <div class="pf-gallery-main">
      {%- if product.media.size > 0 -%}
        {%- assign first_media = product.media.first -%}
        <img
          id="pf-main-img-{{ section.id }}"
          src="{{ first_media | image_url: width: 900 }}"
          alt="{{ first_media.alt | escape }}"
          width="900"
          height="900"
          loading="eager"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
    <div class="pf-gallery-thumbs" id="pf-thumbs-{{ section.id }}">
      {%- for media in product.media -%}
        <div class="pf-thumb{% if forloop.first %} active{% endif %}" data-src="{{ media | image_url: width: 900 }}" data-index="{{ forloop.index0 }}">
          <img
            src="{{ media | image_url: width: 150 }}"
            alt="{{ media.alt | escape }}"
            width="72"
            height="72"
            loading="lazy"
          >
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <!-- Buy Box -->
  <div class="pf-buybox">

    <!-- Stars -->
    <div class="pf-stars-row">
      <span class="pf-stars">★★★★★</span>
      <span class="pf-rating-text">{{ section.settings.rating_text }}</span>
      {%- if section.settings.rating_note != blank -%}
        <span class="pf-rating-note">{{ section.settings.rating_note }}</span>
      {%- endif -%}
    </div>

    <!-- Title -->
    <h1 class="pf-product-title">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        {{ product.title }}
      {%- endif -%}
    </h1>

    {%- if section.settings.subheading != blank -%}
      <p class="pf-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <!-- Price -->
    <div class="pf-price-row">
      <span class="pf-price" id="pf-display-price-{{ section.id }}">
        {{ current_variant.price | money }}
      </span>
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="pf-compare">{{ current_variant.compare_at_price | money }}</span>
        {%- assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
        <span class="pf-save-pill">Save {{ save_pct }}%</span>
      {%- endif -%}
    </div>

    {%- if section.settings.orders_text != blank -%}
      <div class="pf-social-proof">{{ section.settings.orders_text }}</div>
    {%- endif -%}

    {%- if section.settings.bullets != blank -%}
      <div class="pf-bullets">{{ section.settings.bullets }}</div>
    {%- endif -%}

    <!-- Pack Selector -->
    {%- assign pack_blocks = section.blocks | where: 'type', 'pack' -%}
    {%- if pack_blocks.size > 0 -%}
      <div>
        <div class="pf-pack-label">Choose Your Pack</div>
        <div class="pf-packs" id="pf-packs-{{ section.id }}">
          {%- for block in pack_blocks -%}
            <div {{ block.shopify_attributes }} class="pf-pack-option{% if forloop.first %} selected{% endif %}" data-qty="{{ forloop.index }}" data-index="{{ forloop.index0 }}">
              <div class="pf-pack-radio"></div>
              <div class="pf-pack-info">
                <div class="pf-pack-name">{{ block.settings.pack_label }}</div>
                {%- if block.settings.pack_sub != blank -%}
                  <div class="pf-pack-sub">{{ block.settings.pack_sub }}</div>
                {%- endif -%}
              </div>
              {%- if block.settings.pack_tag != blank -%}
                <span class="pf-pack-tag">{{ block.settings.pack_tag }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Order Bump -->
    {%- if section.settings.bump_product != blank -%}
      {%- assign bump_product = all_products[section.settings.bump_product] -%}
      {%- if bump_product != blank -%}
        <div class="pf-order-bump" id="pf-bump-{{ section.id }}">
          <div class="pf-bump-checkbox"></div>
          {%- if bump_product.featured_image -%}
            <img
              class="pf-bump-img"
              src="{{ bump_product.featured_image | image_url: width: 120 }}"
              alt="{{ bump_product.featured_image.alt | escape }}"
              width="56"
              height="56"
              loading="lazy"
            >
          {%- endif -%}
          <div class="pf-bump-text">
            <div class="pf-bump-add">
              {%- if section.settings.bump_label != blank -%}{{ section.settings.bump_label }}{%- else -%}Add-On{%- endif -%}
            </div>
            <div class="pf-bump-label">{{ bump_product.title }}</div>
            {%- if section.settings.bump_sub != blank -%}
              <div class="pf-bump-sub">{{ section.settings.bump_sub }}</div>
            {%- else -%}
              <div class="pf-bump-sub">+ {{ bump_product.price | money }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- Qty + ATC -->
    <form id="pf-form-{{ section.id }}">
      <input type="hidden" name="id" id="pf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
      <div class="pf-qty-atc">
        <div class="pf-qty-wrap">
          <button type="button" class="pf-qty-btn" id="pf-qty-minus-{{ section.id }}">−</button>
          <span class="pf-qty-val" id="pf-qty-val-{{ section.id }}">1</span>
          <button type="button" class="pf-qty-btn" id="pf-qty-plus-{{ section.id }}">+</button>
        </div>
        <button type="submit" class="pf-atc-btn" id="pf-atc-{{ section.id }}">
          <span>🛒</span>
          <span id="pf-atc-text-{{ section.id }}">Add to Cart</span>
        </button>
      </div>
      <div class="pf-total-line" id="pf-total-line-{{ section.id }}" style="margin-top:8px;"></div>
    </form>

    <!-- Trust Strip -->
    {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
    {%- if trust_blocks.size > 0 -%}
      <div class="pf-trust-strip">
        {%- for block in trust_blocks -%}
          <div {{ block.shopify_attributes }} class="pf-trust-item">
            <span class="pf-trust-icon">{{ block.settings.icon }}</span>
            <span class="pf-trust-label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Update Note -->
    {%- if section.settings.update_note != blank -%}
      <div class="pf-update-note">{{ section.settings.update_note }}</div>
    {%- endif -%}

    <!-- Accordion -->
    <div class="pf-accordion" id="pf-accordion-{{ section.id }}">
      {%- if section.settings.spec_text != blank -%}
        <div class="pf-accordion-item">
          <button type="button" class="pf-accordion-trigger">
            <span>Product Details</span>
            <span class="pf-accordion-icon">+</span>
          </button>
