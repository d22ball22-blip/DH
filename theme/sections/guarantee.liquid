<section class="section section--forest"><div class="wrap"><div class="guarantee__inner reveal">
  <div class="guarantee__seal"><div><div class="n">{{ section.settings.days }}</div><div class="d">{{ section.settings.seal_text }}</div></div></div>
  <div class="guarantee__copy"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="display-sm" style="color:var(--ivory);margin-top:12px;">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
  {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="btn btn--light">{{ section.settings.btn_label }}</a>{% endif %}
</div></div></section>
{% schema %}
{ "name": "Guarantee", "settings": [
  { "type": "text", "id": "days", "label": "Days", "default": "90" },
  { "type": "text", "id": "seal_text", "label": "Seal text", "default": "Day Glow Promise" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Risk-Free" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Love your glow, or your money back." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Try Auvelle for a full 90 days. If you're not completely radiant, we'll refund every cent." },
  { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop Risk-Free" },
  { "type": "url", "id": "btn_link", "label": "Button link" }
], "presets": [ { "name": "Guarantee" } ] }
{% endschema %}