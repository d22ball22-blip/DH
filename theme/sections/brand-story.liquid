<section class="section" id="story"><div class="wrap"><div class="story reveal">
  <div class="story__media">
    <img src="{% if section.settings.image1 %}{{ section.settings.image1 | image_url: width: 700 }}{% else %}{{ 'story-founder.jpg' | asset_url }}{% endif %}" alt="" style="aspect-ratio:3/4;object-fit:cover;margin-top:40px;border-radius:6px;">
    <img src="{% if section.settings.image2 %}{{ section.settings.image2 | image_url: width: 700 }}{% else %}{{ 'story-texture.jpg' | asset_url }}{% endif %}" alt="" style="aspect-ratio:3/4;object-fit:cover;border-radius:6px;">
  </div>
  <div class="story__copy">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="display-md">{{ section.settings.heading }}</h2>
    <div class="story__rte">{{ section.settings.text }}</div>
    <p class="story__sign">{{ section.settings.signature }}</p>
    <div class="story__stats">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><div class="n">{{ block.settings.num }}</div><div class="l">{{ block.settings.label }}</div></div>{% endfor %}</div>
  </div>
</div></div></section>
{% schema %}
{ "name": "Brand story", "settings": [
  { "type": "image_picker", "id": "image1", "label": "Image 1" },
  { "type": "image_picker", "id": "image2", "label": "Image 2" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Glow that loves your skin back." },
  { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Auvelle was born from a simple belief — that a healthy, sun-kissed radiance shouldn't cost you your skin's wellbeing.</p>" },
  { "type": "text", "id": "signature", "label": "Signature", "default": "— The Auvelle Atelier" }
], "blocks": [ { "type": "stat", "name": "Stat", "settings": [ { "type": "text", "id": "num", "label": "Number", "default": "10k+" }, { "type": "text", "id": "label", "label": "Label", "default": "Five-star reviews" } ] } ],
  "max_blocks": 3, "presets": [ { "name": "Brand story", "blocks": [ {"type":"stat"},{"type":"stat"},{"type":"stat"} ] } ] }
{% endschema %}