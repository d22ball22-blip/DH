[
  {
    "name": "theme_info",
    "theme_name": "Auvelle 2026",
    "theme_version": "2.0.0",
    "theme_author": "Auvelle Beauty",
    "theme_documentation_url": "https://auvelle.co",
    "theme_support_url": "https://auvelle.co"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Auvelle"
      },
      {
        "type": "text",
        "id": "brand_accent_char",
        "label": "Accent character after name",
        "default": "."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#FAFAF8"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Body text",
        "default": "#1C1612"
      },
      {
        "type": "color",
        "id": "color_bronze",
        "label": "Primary accent (bronze)",
        "default": "#A76B3D"
      },
      {
        "type": "color",
        "id": "color_champagne",
        "label": "Secondary accent (champagne)",
        "default": "#CCAB72"
      },
      {
        "type": "color",
        "id": "color_forest",
        "label": "Deep accent (forest)",
        "default": "#2D4A3E"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "enable_cart_discount",
        "label": "Show discount code field in cart",
        "default": true
      },
      {
        "type": "header",
        "content": "Cart upsell products"
      },
      {
        "type": "product",
        "id": "cart_upsell_product_1",
        "label": "Upsell product 1"
      },
      {
        "type": "product",
        "id": "cart_upsell_product_2",
        "label": "Upsell product 2"
      }
    ]
  },
  {
    "name": "Email popup",
    "settings": [
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Popup product image"
      },
      {
        "type": "text",
        "id": "popup_heading",
        "label": "Popup headline",
        "default": "Unlock Your Glow Ritual"
      },
      {
        "type": "textarea",
        "id": "popup_subtext",
        "label": "Popup supporting text",
        "default": "Join our inner circle and receive 10% off your first order, plus early access to new launches and exclusive member offers."
      },
      {
        "type": "text",
        "id": "klaviyo_list_id",
        "label": "Klaviyo list ID (optional)",
        "info": "Your Klaviyo list ID for newsletter sign-ups via their JS API"
      }
    ]
  },
  {
    "name": "Store info",
    "settings": [
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email",
        "default": "support@auvelle.co"
      },
      {
        "type": "text",
        "id": "support_phone",
        "label": "Support phone",
        "default": "+1 (555) 000-0000"
      },
      {
        "type": "textarea",
        "id": "support_address",
        "label": "Address",
        "default": "123 Glow Avenue, Los Angeles, CA 90001"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
