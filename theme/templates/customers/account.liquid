<section class="page-hero"><div class="wrap"><span class="eyebrow">Auvelle</span><h1 class="display-md">My account</h1></div></section>
<section class="section"><div class="wrap"><div class="prose"><p>Welcome, {{ customer.first_name | default: customer.email }}.</p><p><a href="{{ routes.account_logout_url }}" class="link-underline">Log out</a></p><h2>Orders</h2>{% for order in customer.orders %}<p><a href="{{ order.url }}">Order {{ order.name }}</a> — {{ order.created_at | date: '%b %d, %Y' }} — {{ order.total_price | money }}</p>{% else %}<p>No orders yet.</p>{% endfor %}</div></div></section>