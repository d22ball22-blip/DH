{% layout 'password' %}<section class="section center" style="min-height:70vh;display:grid;place-items:center;"><div class="wrap"><span class="brand" style="font-size:40px;">{{ shop.name }}</span><p class="lede" style="margin:18px auto 28px;">{{ shop.password_message | default: 'Opening soon. Sign up to be the first to glow.' }}</p>{% form 'storefront_password' %}<div style="display:flex;gap:10px;justify-content:center;max-width:420px;margin:0 auto;"><input type="password" name="password" placeholder="Password" style="flex:1;padding:14px;border:1px solid var(--line);border-radius:4px;"><button class="btn btn--primary">Enter</button></div>{% endform %}</div></section>