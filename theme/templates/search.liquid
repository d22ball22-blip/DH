<section class="page-hero"><div class="wrap"><span class="eyebrow">Search</span><h1 class="display-md">Search</h1></div></section>
<section class="section"><div class="wrap" style="max-width:760px;">
  <form action="{{ routes.search_url }}" method="get" class="contact-form"><div class="field"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..."></div><button class="btn btn--primary" style="justify-self:start;">Search</button></form>
  {% if search.performed %}<div class="prod-grid" style="margin-top:40px;">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}{% endfor %}</div>{% endif %}
</div></section>